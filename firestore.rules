rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model for Life Daily
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //   - isAnonymous: bool (required)
    //   - linkedProviders: list<string> (required, max 4, each in [anonymous, google.com, apple.com, password])
    //   - schemaVersion: number (required, immutable, must be 1)
    //   - displayName: string (required, 0-40, write-once: may only change from '')
    //
    // Subcollection: users/{userId}/goals/{goalId}
    //   - ownerId: string (required, immutable, == userId)
    //   - title: string (1-120)
    //   - details: string (0-2000)
    //   - kind: string in ['once','habit']
    //   - startsAt: timestamp (required)
    //   - dueAt: timestamp (required)
    //   - category: string
    //   - status: string in ['active','done']
    //   - checkIns: list<string> (required, max 366)
    //   - tasks: list (optional)
    //   - trackers: list (optional)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Subcollection: users/{userId}/finance_categories/{categoryId}
    //   - ownerId: string (required, immutable, == userId)
    //   - name: string (0-40)
    //   - builtInKey: string (0-40)
    //   - iconKey: string (1-40)
    //   - role: string in ['spend','allocate','income']
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Subcollection: users/{userId}/finance_month_plans/{yyyy-mm}
    //   - ownerId: string (required, immutable, == userId)
    //   - yearMonth: string (7 chars, YYYY-MM)
    //   - expectedSalary: number (0 to 1000000000)
    //   - spendBudget: number (0 to 1000000000)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Subcollection: users/{userId}/finance_entries/{entryId}
    //   - ownerId: string (required, immutable, == userId)
    //   - kind: string in ['expense','income','salary','debt']
    //   - title: string (1-80)
    //   - amount: number (0 to 1000000000)
    //   - categoryId: string (0-64)
    //   - occurredAt: timestamp (required)
    //   - note: string (0-500)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Subcollection: users/{userId}/finance_commitments/{commitmentId}
    //   - ownerId: string (required, immutable, == userId)
    //   - title: string (1-120)
    //   - amount: number (0 to 1000000000)
    //   - dueDay: number (1 to 31)
    //   - isPaid: bool
    //   - categoryId: string (0-64)
    //   - note: string (0-500)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Access: owner-only. Anonymous and linked accounts share the same uid.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProviderList(value) {
      return value is list
        && value.size() <= 4
        && (value.size() == 0 || value[0] in ['anonymous', 'google.com', 'apple.com', 'password'])
        && (value.size() < 2 || value[1] in ['anonymous', 'google.com', 'apple.com', 'password'])
        && (value.size() < 3 || value[2] in ['anonymous', 'google.com', 'apple.com', 'password'])
        && (value.size() < 4 || value[3] in ['anonymous', 'google.com', 'apple.com', 'password']);
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'createdAt',
          'updatedAt',
          'isAnonymous',
          'linkedProviders',
          'schemaVersion',
          'displayName'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.isAnonymous is bool
        && isValidProviderList(data.linkedProviders)
        && data.schemaVersion is number
        && data.schemaVersion == 1
        && data.displayName is string
        && data.displayName.size() <= 40;
    }

    function isValidGoal(data, userId) {
      return (data.keys().hasOnly([
          'ownerId',
          'title',
          'details',
          'kind',
          'startsAt',
          'dueAt',
          'category',
          'status',
          'checkIns',
          'createdAt',
          'updatedAt'
        ]) || data.keys().hasOnly([
          'ownerId',
          'title',
          'details',
          'kind',
          'startsAt',
          'dueAt',
          'category',
          'status',
          'checkIns',
          'createdAt',
          'updatedAt',
          'tasks',
          'trackers'
        ]))
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.details is string
        && data.details.size() <= 2000
        && data.kind in ['once', 'habit']
        && data.startsAt is timestamp
        && data.dueAt is timestamp
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 64
        && data.status in ['active', 'done']
        && data.checkIns is list
        && data.checkIns.size() <= 366
        && (!('tasks' in data) || data.tasks is list)
        && (!('trackers' in data) || data.trackers is list)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoalCategory(data, userId) {
      return data.keys().hasOnly([
          'ownerId',
          'name',
          'builtInKey',
          'iconKey',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() <= 40
        && data.builtInKey is string
        && data.builtInKey.size() <= 40
        && data.iconKey is string
        && data.iconKey.size() >= 1
        && data.iconKey.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinanceCategory(data, userId) {
      return data.keys().hasOnly([
          'ownerId',
          'name',
          'builtInKey',
          'iconKey',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() <= 40
        && data.builtInKey is string
        && data.builtInKey.size() <= 40
        && data.iconKey is string
        && data.iconKey.size() >= 1
        && data.iconKey.size() <= 40
        && data.role in ['spend', 'allocate', 'income']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinanceMonthPlan(data, userId) {
      return data.keys().hasOnly([
          'ownerId',
          'yearMonth',
          'expectedSalary',
          'spendBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.yearMonth is string
        && data.yearMonth.size() == 7
        && data.expectedSalary is number
        && data.expectedSalary >= 0
        && data.expectedSalary <= 1000000000
        && data.spendBudget is number
        && data.spendBudget >= 0
        && data.spendBudget <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinance(data, userId) {
      return data.keys().hasOnly([
          'ownerId',
          'kind',
          'title',
          'amount',
          'categoryId',
          'occurredAt',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.kind in ['expense', 'income', 'salary', 'debt']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 1000000000
        && data.categoryId is string
        && data.categoryId.size() <= 64
        && data.occurredAt is timestamp
        && data.note is string
        && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinanceCommitment(data, userId) {
      return data.keys().hasOnly([
          'ownerId',
          'title',
          'amount',
          'dueDay',
          'isPaid',
          'categoryId',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 1000000000
        && data.dueDay is number
        && data.dueDay >= 1
        && data.dueDay <= 31
        && data.isPaid is bool
        && data.categoryId is string
        && data.categoryId.size() <= 64
        && data.note is string
        && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && (resource.data.displayName == ''
          || request.resource.data.displayName == resource.data.displayName);
      allow delete: if false;

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidGoal(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidGoal(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /goal_categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidGoalCategory(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidGoalCategory(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /finance_categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidFinanceCategory(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidFinanceCategory(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /finance_entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidFinance(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidFinance(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /finance_month_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidFinanceMonthPlan(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidFinanceMonthPlan(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /finance_commitments/{commitmentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidFinanceCommitment(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidFinanceCommitment(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
